{
    "manifest_version": 3,
    "name": "LET - No sunny",
    "version": "5.0",
    "description": "Remove annoying no-sunny type people's posts because they're morons",
  
    "icons": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    },
    "content_scripts": [
      {
        "js": ["includes/jquery-3.7.1.min.js", "includes/jquery-ui.min.js", "includes/content.js"],
        "matches": [
          "https://lowendtalk.com/*",
          "https://lowendtalk.com/*/*",
          "https://lowendtalk.com/*/*/*",
          "https://lowendtalk.com/*/*/*/*"
        ]
      }
    ]
  }